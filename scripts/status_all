#!/bin/zsh

# agentic-control-plane — check service status: tmux sessions + HTTP health.

export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
TMUX="${TMUX_BIN:-$(command -v tmux || true)}"

echo "🔍 agentic-control-plane status"
echo ""

for session in acp-api acp-web; do
    if [[ -n "$TMUX" && -x "$TMUX" ]] && "$TMUX" has-session -t "$session" 2>/dev/null; then
        echo "✅ tmux session '$session' is running"
    else
        echo "❌ tmux session '$session' is not running"
    fi
done

echo ""

if curl -sf http://localhost:8400/api/v1/health > /dev/null 2>&1; then
    echo "✅ API responding on http://localhost:8400"
else
    echo "❌ API not responding on http://localhost:8400"
fi

if curl -sf http://localhost:5400 > /dev/null 2>&1; then
    echo "✅ Web UI responding on http://localhost:5400"
else
    echo "❌ Web UI not responding on http://localhost:5400"
fi

echo ""
echo "Recent worker activity (apps/api/logs/worker.log):"
tail -3 "$(cd "$(dirname "$0")/.." && pwd)/apps/api/logs/worker.log" 2>/dev/null || echo "  (no worker log yet)"
